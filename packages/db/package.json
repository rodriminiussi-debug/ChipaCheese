{
  "name": "@chipa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./reset": "./src/reset.ts",
    "./showcase": "./src/showcase.ts",
    "./seed-data": "./src/seed/data.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "reset": "tsx src/reset.ts",
    "showcase": "tsx src/showcase.ts",
    "studio": "drizzle-kit studio",
