# Base de datos (docker compose expone Postgres en 5433)
DATABASE_URL=postgres://chipa:chipa@localhost:5433/chipa
# Sesiones: cadena aleatoria de 32+ caracteres
SESSION_SECRET=dev-only-change-me-0123456789abcdef
APP_URL=http://localhost:3000
# Archivos: local (disco, dev/test) | s3 (Supabase Storage u otro S3 en prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=chipa-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Lectura de facturas con IA. Sin clave se usa el extractor simulado.
ANTHROPIC_API_KEY=
# Modelo de visión (opcional; default claude-sonnet-5-5). AI_MOCK=1 fuerza el extractor simulado.
# AI_MODEL=claude-sonnet-5-5
# Tests (opcional: por defecto chipa_test y puerto 3200)
# TEST_DATABASE_URL=postgres://chipa:chipa@localhost:5433/chipa_test
# E2E_PORT=3200
